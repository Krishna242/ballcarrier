# Data — never tracked. The lesson from the previous repo: results/ was
# gitignored only AFTER its contents were committed, so the ignore did nothing
# and outputs drifted inside version control.
data/raw/
data/interim/
data/labels/
data/external/

# Model weights
*.pt
*.pth
*.onnx

# Outputs
*.mp4
*.avi
*.png
*.jpg

# ...except the committed demo and figures, which are the deliverable. Kept
# small on purpose (H.264, ~11 MB total); regenerate with scripts/make_demos.py
# and scripts/results_card.py rather than adding new ones by hand.
!docs/**/*.mp4
!docs/**/*.png

# Python
__pycache__/
*.py[cod]
.venv/
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
